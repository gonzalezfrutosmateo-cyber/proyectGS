<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Torneos y Ediciones — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'torneos' }) %>

    <main>
        <div class="encabezado">
            <a href="/torneos" class="volver">← Volver a Torneos</a>
            <h3>Torneos y ediciones</h3>
        </div>

        <% if (mensaje) { %>
            <p class="aviso aviso-ok"><%= mensaje %></p>
        <% } %>

        <section class="card">
            <h4>Torneos</h4>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Torneo</th>
                            <th>País</th>
                            <th>Ediciones Cargadas</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (torneos.length === 0) { %>
                            <tr class="no-results"><td colspan="3">No hay torneos cargados.</td></tr>
                        <% } %>
                        <% torneos.forEach(t => { %>
                            <tr>
                                <td><%= t.nombre %></td>
                                <td><%= t.pais %></td>
                                <td><%= t.ediciones %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card">
            <h4>Ediciones (<%= ediciones.length %>)</h4>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Torneo</th>
                            <th>Año</th>
                            <th>Sede</th>
                            <th>País</th>
                            <th>Partidos Cargados</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (ediciones.length === 0) { %>
                            <tr class="no-results"><td colspan="5">Todavía no hay ediciones cargadas.</td></tr>
                        <% } %>
                        <% ediciones.forEach(e => { %>
                            <tr>
                                <td><%= e.torneo %></td>
                                <td><%= e.anio %></td>
                                <td><%= e.sede %></td>
                                <td><%= e.pais %></td>
                                <td><%= e.partidos %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>

</html>
