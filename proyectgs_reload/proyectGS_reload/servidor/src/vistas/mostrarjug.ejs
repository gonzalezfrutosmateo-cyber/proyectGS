<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Jugadores — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'jugadores' }) %>

    <main>
        <div class="encabezado">
            <a href="/jugadores" class="volver">← Volver a Jugadores</a>
            <h3>Lista de jugadores</h3>
        </div>

        <section class="card">
            <h4>Jugadores (<%= jugadores.length %>)</h4>

            <% if (mensaje) { %>
                <p class="aviso aviso-ok"><%= mensaje %></p>
            <% } %>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Nacionalidad</th>
                            <th>Período Activo</th>
                            <th>Ganancias Totales</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (jugadores.length === 0) { %>
                            <tr class="no-results"><td colspan="5">Todavía no hay jugadores cargados.</td></tr>
                        <% } %>
                        <% jugadores.forEach(j => { %>
                            <tr>
                                <td><%= j.nombre %></td>
                                <td><%= j.apellido %></td>
                                <td><%= j.nacionalidad || '-' %></td>
                                <td><%= j.periodo || '-' %></td>
                                <td><%= j.ganancias != null ? '$ ' + Number(j.ganancias).toLocaleString('es-AR') : '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <p class="texto-chico">El período activo y las ganancias se calculan con los partidos y premios cargados.</p>
        </section>
    </main>
</body>

</html>
