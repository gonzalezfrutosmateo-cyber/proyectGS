<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buscar Jugador — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'jugadores' }) %>

    <main>
        <div class="encabezado">
            <a href="/jugadores" class="volver">← Volver a Jugadores</a>
            <h3>Buscar jugador</h3>
        </div>

        <section class="search-section">
            <form class="search-form" action="/consultarjug" method="GET">
                <input type="text" name="apellido" placeholder="Buscar por apellido..." maxlength="50" value="<%= apellido %>" autofocus>
                <button type="submit">Buscar</button>
            </form>
        </section>

        <% if (jugadores !== null) { %>
            <section class="card">
                <h4>Resultados (<%= jugadores.length %>)</h4>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Nacionalidad</th>
                                <th>Período Activo</th>
                                <th>Ganancias Totales</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (jugadores.length === 0) { %>
                                <tr class="no-results"><td colspan="5">No se encontraron jugadores.</td></tr>
                            <% } %>
                            <% jugadores.forEach(j => { %>
                                <tr>
                                    <td><%= j.nombre %></td>
                                    <td><%= j.apellido %></td>
                                    <td><%= j.nacionalidad || '-' %></td>
                                    <td><%= j.periodo || '-' %></td>
                                    <td><%= j.ganancias != null ? '$ ' + Number(j.ganancias).toLocaleString('es-AR') : '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        <% } %>
    </main>
</body>

</html>
