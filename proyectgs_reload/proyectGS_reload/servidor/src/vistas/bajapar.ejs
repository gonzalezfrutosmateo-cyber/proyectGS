<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eliminar Partido — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'partidos' }) %>

    <main>
        <div class="encabezado">
            <a href="/partidos" class="volver">← Volver a Partidos</a>
            <h3>Eliminar partido</h3>
        </div>

        <%- include('partials/filtrospartido', { accion: '/bajapar' }) %>

        <section class="card">
            <h4>Elegí el partido que querés eliminar</h4>

            <% if (mensaje) { %>
                <p class="aviso aviso-ok"><%= mensaje %></p>
            <% } %>
            <% if (error) { %>
                <p class="aviso aviso-error"><%= error %></p>
            <% } %>

            <%- include('partials/tablapartidos', { accion: 'eliminar' }) %>
        </section>
    </main>
</body>

</html>
