<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Partido — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'partidos' }) %>

    <main>
        <div class="encabezado">
            <a href="/partidos" class="volver">← Volver a Partidos</a>
            <h3>Modificar partido</h3>
        </div>

        <% if (partido) { %>
            <!-- Formulario con los datos del partido elegido -->
            <section class="card">
                <h4>Datos del partido</h4>

                <% if (error) { %>
                    <p class="aviso aviso-error"><%= error %></p>
                <% } %>

                <%- include('partials/formpartido', { accion: '/actualizarpar', cancelar: '/modpar', boton: 'Guardar cambios' }) %>
            </section>
        <% } else { %>
            <!-- Lista para elegir qué partido modificar -->
            <%- include('partials/filtrospartido', { accion: '/modpar' }) %>

            <section class="card">
                <h4>Elegí el partido que querés modificar</h4>
                <%- include('partials/tablapartidos', { accion: 'modificar' }) %>
            </section>
        <% } %>
    </main>
</body>

</html>
