<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Torneo</th>
                <th>Año</th>
                <th>Fase</th>
                <th>Modalidad</th>
                <th>Ganador</th>
                <th>Perdedor</th>
                <th>Resultado</th>
                <th>Árbitro</th>
                <th>Premio Perdedor</th>
                <% if (accion) { %>
                    <th>Acción</th>
                <% } %>
            </tr>
        </thead>
        <tbody>
            <% if (partidos.length === 0) { %>
                <tr class="no-results"><td colspan="<%= accion ? 10 : 9 %>">No se encontraron partidos.</td></tr>
            <% } %>
            <% partidos.forEach(p => {
                let resultado = p.resultado || '-';
                if (p.estado === 'walkover') { resultado = 'W.O.'; }
                else if (p.estado === 'abandono') { resultado += ' (abandono)'; }
            %>
                <tr>
                    <td><%= p.torneo %></td>
                    <td><%= p.anio %></td>
                    <td><%= p.fase %></td>
                    <td><%= p.modalidad_texto %></td>
                    <td><%= p.ganador || '-' %></td>
                    <td><%= p.perdedor || '-' %></td>
                    <td><%= resultado %></td>
                    <td><%= p.arbitro %></td>
                    <td><%= p.monto_perdedor != null ? '$ ' + Number(p.monto_perdedor).toLocaleString('es-AR') : '-' %></td>
                    <% if (accion === 'eliminar') { %>
                        <td class="celda-accion">
                            <form action="/eliminarpar" method="POST" onsubmit="return confirm('¿Seguro que querés eliminar este partido?')">
                                <input type="hidden" name="id" value="<%= p.id_partido %>">
                                <button type="submit" class="btn-delete">Eliminar</button>
                            </form>
                        </td>
                    <% } %>
                    <% if (accion === 'modificar') { %>
                        <td class="celda-accion"><a href="/modpar?id=<%= p.id_partido %>" class="btn-edit">Modificar</a></td>
                    <% } %>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
