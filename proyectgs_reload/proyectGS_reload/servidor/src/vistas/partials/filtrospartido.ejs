<section class="search-section">
    <form class="search-form" action="<%= accion %>" method="GET">
        <select name="torneo">
            <option value="">Todos los torneos</option>
            <% torneos.forEach(t => { %>
                <option value="<%= t.id_torneo %>" <%= String(filtros.torneo) === String(t.id_torneo) ? 'selected' : '' %>><%= t.nombre %></option>
            <% }) %>
        </select>
        <select name="anio">
            <option value="">Todos los años</option>
            <% anios.forEach(a => { %>
                <option value="<%= a %>" <%= String(filtros.anio) === String(a) ? 'selected' : '' %>><%= a %></option>
            <% }) %>
        </select>
        <select name="modalidad">
            <option value="">Todas las modalidades</option>
            <% Object.keys(modalidades).forEach(valor => { %>
                <option value="<%= valor %>" <%= filtros.modalidad === valor ? 'selected' : '' %>><%= modalidades[valor] %></option>
            <% }) %>
        </select>
        <button type="submit">Buscar</button>
    </form>
</section>
