<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buscar Torneo — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'torneos' }) %>

    <main>
        <div class="encabezado">
            <a href="/torneos" class="volver">← Volver a Torneos</a>
            <h3>Buscar torneo</h3>
        </div>

        <section class="search-section">
            <form class="search-form" action="/consultartor" method="GET">
                <select name="anio" required>
                    <option value="">Seleccionar año...</option>
                    <% anios.forEach(a => { %>
                        <option value="<%= a %>" <%= String(filtros.anio) === String(a) ? 'selected' : '' %>><%= a %></option>
                    <% }) %>
                </select>
                <select name="torneo" required>
                    <option value="">Seleccionar torneo...</option>
                    <% torneos.forEach(t => { %>
                        <option value="<%= t.id_torneo %>" <%= String(filtros.torneo) === String(t.id_torneo) ? 'selected' : '' %>><%= t.nombre %></option>
                    <% }) %>
                </select>
                <button type="submit">Buscar</button>
            </form>
        </section>

        <% if (partidos !== null) { %>
            <section class="card">
                <% if (!edicion) { %>
                    <h4>Partidos del Torneo</h4>
                    <p class="aviso aviso-error">No hay una edición de ese torneo en ese año.</p>
                <% } else { %>
                    <h4><%= edicion.torneo %> <%= edicion.anio %></h4>
                    <p class="texto-chico">Sede: <%= edicion.sede %> (<%= edicion.pais %>) · <%= partidos.length %> partidos cargados</p>
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Modalidad</th>
                                    <th>Fase</th>
                                    <th>Ganador</th>
                                    <th>Perdedor</th>
                                    <th>Resultado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (partidos.length === 0) { %>
                                    <tr class="no-results"><td colspan="5">Esta edición todavía no tiene partidos cargados.</td></tr>
                                <% } %>
                                <% partidos.forEach(p => {
                                    let resultado = p.resultado || '-';
                                    if (p.estado === 'walkover') { resultado = 'W.O.'; }
                                    else if (p.estado === 'abandono') { resultado += ' (abandono)'; }
                                %>
                                    <tr>
                                        <td><%= p.modalidad_texto %></td>
                                        <td><%= p.fase %></td>
                                        <td><%= p.ganador || '-' %></td>
                                        <td><%= p.perdedor || '-' %></td>
                                        <td><%= resultado %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        <% } %>
    </main>
</body>

</html>
