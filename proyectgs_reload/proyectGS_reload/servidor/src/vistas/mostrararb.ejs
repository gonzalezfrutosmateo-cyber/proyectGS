<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Árbitros — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'arbitros' }) %>

    <main>
        <div class="encabezado">
            <a href="/arbitros" class="volver">← Volver a Árbitros</a>
            <h3>Lista de árbitros</h3>
        </div>

        
        <section class="card">
            <h4>Árbitros (<%= arbitros.length %>)</h4>

            <% if (mensaje) { %>
                <p class="aviso aviso-ok"><%= mensaje %></p>
            <% } %>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Partidos Dirigidos</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (arbitros.length === 0) { %>
                            <tr class="no-results"><td colspan="3">Todavía no hay árbitros cargados.</td></tr>
                        <% } %>
                        <% arbitros.forEach(a => { %>
                            <tr>
                                <td><%= a.nombre %></td>
                                <td><%= a.apellido %></td>
                                <td><%= a.partidos %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>

</html>
