<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Árbitro — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('partials/navbar', { activo: 'arbitros' }) %>

    <main>
        <div class="encabezado">
            <a href="/arbitros" class="volver">← Volver a Árbitros</a>
            <h3>Modificar árbitro</h3>
        </div>

        <% if (mensaje) { %>
            <script>Swal.fire("¡Éxito!", "<%= mensaje %>", "success");</script>
        <% } %>

        <% if (arbitro) { %>
            <!-- Formulario con los datos del árbitro elegido -->
            <section class="card">
                <h4>Datos del árbitro</h4>

                <% if (error) { %>
                    <script>Swal.fire("Error", "<%= error %>", "error");</script>
                <% } %>

                <form action="/actualizararb" method="POST">
                    <input type="hidden" name="id" value="<%= arbitro.id_arbitro %>">
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="nombre">Nombre</label>
                            <input data-solo="letras" id="nombre" name="nombre" type="text" maxlength="50" required value="<%= arbitro.nombre %>">
                        </div>
                        <div class="form-field">
                            <label for="apellido">Apellido</label>
                            <input data-solo="letras" id="apellido" name="apellido" type="text" maxlength="50" required value="<%= arbitro.apellido %>">
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/modarb" class="btn-cancel">Cancelar</a>
                        <button type="submit" class="btn-guardar">Guardar cambios</button>
                    </div>
                </form>
            </section>
        <% } else { %>
            <!-- Lista para elegir qué árbitro modificar -->
            <section class="search-section">
                <form class="search-form" action="/modarb" method="GET">
                    <input data-solo="letras" type="text" name="apellido" placeholder="Buscar por apellido..." maxlength="50" value="<%= apellido %>">
                    <button type="submit">Buscar</button>
                </form>
            </section>

            <section class="card">
                <h4>Elegí el árbitro que querés modificar</h4>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (arbitros.length === 0) { %>
                                <tr class="no-results"><td colspan="3">No se encontraron árbitros.</td></tr>
                            <% } %>
                            <% arbitros.forEach(a => { %>
                                <tr>
                                    <td><%= a.nombre %></td>
                                    <td><%= a.apellido %></td>
                                    <td class="celda-accion"><a href="/modarb?id=<%= a.id_arbitro %>" class="btn-edit">Modificar</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        <% } %>
    </main>
</body>

</html>
