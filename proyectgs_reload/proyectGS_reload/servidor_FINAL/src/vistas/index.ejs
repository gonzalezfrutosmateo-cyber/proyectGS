<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grand History — Sistema de Torneos de Tenis</title>
    <link rel="stylesheet" href="/css/est.css">
</head>

<body>
    <%- include('partials/navbar', { activo: 'inicio' }) %>

    <main>
        <section class="hero hero-inicio">
            <h2>Sistema de Memorización de Torneos de Tenis Grand Slam</h2>
            <p>El sistema registra todos los encuentros, árbitros, premios y datos de jugadores a lo largo de toda la historia del Grand Slam.</p>
        </section>

        <section class="torneos-section">
            <h3>Los Cuatro Torneos del Grand Slam</h3>
            <div class="torneos-grid">
                <div class="torneo-card wimbledon">
                    <img src="/img/wimbledon.jpg" alt="Wimbledon">
                    <div class="torneo-card-content">
                        <h4>Wimbledon</h4>
                        <p><strong>País:</strong> <span class="country-name">Gran Bretaña <img src="/img/bandera-gran-bretana.png" alt="Bandera de Gran Bretaña"></span></p>
                        <p><strong>Sede:</strong> All England Club, Londres</p>
                        <p><strong>Superficie:</strong> Césped</p>
                    </div>
                </div>
                <div class="torneo-card us-open">
                    <img src="/img/us-open.jpg" alt="US Open">
                    <div class="torneo-card-content">
                        <h4>US Open</h4>
                        <p><strong>País:</strong> <span class="country-name">Estados Unidos <img src="/img/bandera-estados-unidos.png" alt="Bandera de Estados Unidos"></span></p>
                        <p><strong>Sedes:</strong> Forest Hills, Flushing Meadows</p>
                        <p><strong>Superficie:</strong> Cancha dura</p>
                    </div>
                </div>
                <div class="torneo-card roland-garros">
                    <img src="/img/roland-garros.jpg" alt="Roland Garros">
                    <div class="torneo-card-content">
                        <h4>Roland Garros</h4>
                        <p><strong>País:</strong> <span class="country-name">Francia <img src="/img/bandera-francia.png" alt="Bandera de Francia"></span></p>
                        <p><strong>Sede:</strong> Stade Roland Garros, París</p>
                        <p><strong>Superficie:</strong> Arcilla</p>
                    </div>
                </div>
                <div class="torneo-card australian-open">
                    <img src="/img/australian-open.jpg" alt="Australian Open">
                    <div class="torneo-card-content">
                        <h4>Australian Open</h4>
                        <p><strong>País:</strong> <span class="country-name">Australia <img src="/img/bandera-australia.png" alt="Bandera de Australia"></span></p>
                        <p><strong>Sede:</strong> Melbourne Park, Melbourne</p>
                        <p><strong>Superficie:</strong> Cancha dura</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</body>

</html>
