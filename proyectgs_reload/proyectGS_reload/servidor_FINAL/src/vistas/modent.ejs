<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Entrenador — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('partials/navbar', { activo: 'entrenadores' }) %>

    <main>
        <div class="encabezado">
            <a href="/entrenadores" class="volver">← Volver a Entrenadores</a>
            <h3>Modificar entrenador</h3>
        </div>

        <% if (mensaje) { %>
            <script>Swal.fire("¡Éxito!", "<%= mensaje %>", "success");</script>
        <% } %>

        <% if (entrenador) { %>
            <!-- Formulario con los datos del entrenador elegido -->
            <section class="card">
                <h4>Datos del entrenador</h4>

                <% if (error) { %>
                    <script>Swal.fire("Error", "<%= error %>", "error");</script>
                <% } %>

                <form action="/actualizarent" method="POST">
                    <input type="hidden" name="id" value="<%= entrenador.id_entrenador %>">
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="nombre">Nombre</label>
                            <input data-solo="letras" id="nombre" name="nombre" type="text" maxlength="50" required value="<%= entrenador.nombre %>">
                        </div>
                        <div class="form-field">
                            <label for="apellido">Apellido</label>
                            <input data-solo="letras" id="apellido" name="apellido" type="text" maxlength="50" required value="<%= entrenador.apellido %>">
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/modent" class="btn-cancel">Cancelar</a>
                        <button type="submit" class="btn-guardar">Guardar cambios</button>
                    </div>
                </form>
            </section>
        <% } else { %>
            <!-- Lista para elegir qué entrenador modificar -->
            <section class="search-section">
                <form class="search-form" action="/modent" method="GET">
                    <input data-solo="letras" type="text" name="apellido" placeholder="Buscar por apellido..." maxlength="50" value="<%= apellido %>">
                    <button type="submit">Buscar</button>
                </form>
            </section>

            <section class="card">
                <h4>Elegí el entrenador que querés modificar</h4>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (entrenadores.length === 0) { %>
                                <tr class="no-results"><td colspan="3">No se encontraron entrenadores.</td></tr>
                            <% } %>
                            <% entrenadores.forEach(e => { %>
                                <tr>
                                    <td><%= e.nombre %></td>
                                    <td><%= e.apellido %></td>
                                    <td class="celda-accion"><a href="/modent?id=<%= e.id_entrenador %>" class="btn-edit">Modificar</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        <% } %>
    </main>
</body>

</html>
