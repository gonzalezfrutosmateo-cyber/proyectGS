<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar Partido — Grand History</title>
    <link rel="stylesheet" href="/css/est.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('partials/navbar', { activo: 'partidos' }) %>

    <main>
        <div class="encabezado">
            <a href="/partidos" class="volver">← Volver a Partidos</a>
            <h3>Agregar partido</h3>
        </div>

        <% if (mensaje) { %>
            <script>Swal.fire("¡Éxito!", "<%= mensaje %>", "success");</script>
        <% } %>

        <section class="card">
            <h4>Datos del partido</h4>

            <% if (error) { %>
                <script>Swal.fire("Error", "<%= error %>", "error");</script>
            <% } %>

            <%- include('partials/formpartido', { accion: '/nuevopar', cancelar: '/partidos', boton: 'Guardar' }) %>
        </section>
    </main>
</body>

</html>
