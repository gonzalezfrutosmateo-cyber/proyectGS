<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Partido</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Editando Partido</h1>
    <form action="/partidos/modificar/<%= partido.id_partido %>" method="POST">
        <label>Torneo:</label>
        <select name="id_torneo" required>
            <% torneos.forEach(t => { %>
                <option value="<%= t.id_torneo %>" <%= t.id_torneo === partido.id_torneo ? 'selected' : '' %>>
                    <%= t.nombre %> (<%= t.anio %>)
                </option>
            <% }) %>
        </select>

        <label>Modalidad:</label>
        <select name="id_modalidad" required>
            <% modalidades.forEach(m => { %>
                <option value="<%= m.id_modalidad %>" <%= m.id_modalidad === partido.id_modalidad ? 'selected' : '' %>>
                    <%= m.nombre %>
                </option>
            <% }) %>
        </select>

        <label>Árbitro:</label>
        <select name="id_arbitro" required>
            <% arbitros.forEach(a => { %>
                <option value="<%= a.id_arbitro %>" <%= a.id_arbitro === partido.id_arbitro ? 'selected' : '' %>>
                    <%= a.nombre %> <%= a.apellido %>
                </option>
            <% }) %>
        </select>

        <label>Fase:</label>
        <input type="text" name="fase" value="<%= partido.fase %>" required>

        <label>Resultado:</label>
        <input type="text" name="resultado" value="<%= partido.resultado %>" required>

        <label>Jugadores (Ctrl para varios):</label>
        <select name="jugadores" multiple size="4" required>
            <% jugadores.forEach(j => { 
                // Verificamos si el jugador ya estaba en este partido
                const estaEnPartido = participaciones.some(p => p.id_jugador === j.id_jugador);
            %>
                <option value="<%= j.id_jugador %>" <%= estaEnPartido ? 'selected' : '' %>>
                    <%= j.nombre %> <%= j.apellido %>
                </option>
            <% }) %>
        </select>

        <label>Ganador(es) (Ctrl para varios):</label>
        <select name="ganadores" multiple size="4" required>
            <% jugadores.forEach(j => { 
                // Verificamos si el jugador ya estaba y si ganó
                const gano = participaciones.some(p => p.id_jugador === j.id_jugador && p.es_ganador === 1);
            %>
                <option value="<%= j.id_jugador %>" <%= gano ? 'selected' : '' %>>
                    <%= j.nombre %> <%= j.apellido %>
                </option>
            <% }) %>
        </select>

        <button type="submit">Guardar Cambios</button>
    </form>
    <br><a href="/partidos/modificar">Cancelar</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>

    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'datos') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Datos inválidos',
            text: 'Revisa los datos ingresados e inténtalo de nuevo.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'relacion') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
        });
    </script>
    <% } %>
    <script src="/js/script.js" defer></script>
</body>
</html>