<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Buscar Partido</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/script.js" defer></script>
</head>
<body>
    <h1>Buscar Partido</h1>
    <a href="/partidos">Volver al menú</a>

    <div class="filtro">
        <form action="/partidos/buscar" method="GET">
            <label>Categoría:</label>
            <select name="id_modalidad">
                <option value="">Todas</option>
                <% modalidades.forEach(m => { %>
                    <option value="<%= m.id_modalidad %>" <%= idModalidad == m.id_modalidad ? 'selected' : '' %>><%= m.nombre %> (<%= m.jugadores_por_lado %> vs <%= m.jugadores_por_lado %>)</option>
                <% }) %>
            </select>

            <label>Torneo o fase (opcional):</label>
            <input type="text" name="buscar" value="<%= buscar %>" placeholder="Ej: Roland Garros o Final">

            <button type="submit">Buscar</button>
        </form>
    </div>

    <% if (idModalidad || buscar) { %>
        <h2>Resultados</h2>
        <% if (partidos.length > 0) { %>
            <table>
                <tr>
                    <th>ID</th><th>Torneo</th><th>Fase</th><th>Resultado</th><th>Modalidad</th><th>Árbitro</th>
                </tr>
                <% partidos.forEach(p => { %>
                    <tr>
                        <td><%= p.id_partido %></td>
                        <td><%= p.torneo %> (<%= p.anio %>)</td>
                        <td><%= p.fase %></td>
                        <td><%= p.resultado %></td>
                        <td><%= p.modalidad %></td>
                        <td><%= p.arbitro %></td>
                    </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p>No se encontró ningún partido con esa búsqueda.</p>
        <% } %>
    <% } %>
    <% if ((idModalidad || buscar) && partidos.length === 0) { %>
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Sin resultados',
            text: 'No se encontraron partidos con esos filtros.'
        });
    </script>
    <% } %>
</body>
</html>
