<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Lista de Partidos</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <h1>Partidos Registrados</h1>
    <a href="/partidos">Volver al menú</a>
    <table>
        <tr>
            <th>ID</th>
            <th>Torneo</th>
            <th>Fase</th>
            <th>Resultado</th>
            <th>Modalidad</th>
            <th>Árbitro</th>
        </tr>
        <% partidos.forEach(p=> { %>
            <tr>
                <td>
                    <%= p.id_partido %>
                </td>
                <td>
                    <%= p.torneo %> (<%= p.anio %>)
                </td>
                <td>
                    <%= p.fase %>
                </td>
                <td>
                    <%= p.resultado %>
                </td>
                <td>
                    <%= p.modalidad %>
                </td>
                <td>
                    <%= p.arbitro %>
                </td>
            </tr>
            <% }) %>
    </table>
    <% if (typeof status !=='undefined' && status==='success' ) { %>
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Operación realizada',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
        <% } %>

            <% if (typeof status !=='undefined' && status==='error' && tipo==='datos' ) { %>
                <script>
                    Swal.fire({
                        icon: 'error',
                        title: 'Datos inválidos',
                        text: 'Revisa los datos ingresados e inténtalo de nuevo.'
                    });
                </script>
                <% } else if (typeof status !=='undefined' && status==='error' && tipo==='relacion' ) { %>
                    <script>
                        Swal.fire({
                            icon: 'error',
                            title: 'No se pudo completar',
                            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
                        });
                    </script>
                    <% } else if (typeof status !=='undefined' && status==='error' ) { %>
                        <script>
                            Swal.fire({
                                icon: 'error',
                                title: 'No se pudo completar',
                                text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
                            });
                        </script>
                        <% } %>
</body>

</html>