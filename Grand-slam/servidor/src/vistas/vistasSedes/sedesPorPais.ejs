<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Sedes por premios de un país</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/script.js" defer></script>
</head>
<body>
    <h1>Sedes donde un país ganó más premios</h1>
    <a href="/sedes">Volver al menú</a>

    <div class="filtro">
        <form action="/sedes/pais" method="GET">
            <label>Seleccione un País:</label>
            <select name="id_pais" required>
                <option value="">Seleccione...</option>
                <% paises.forEach(p => { %>
                    <option value="<%= p.id_pais %>" <%= idPais == p.id_pais ? 'selected' : '' %>>
                        <%= p.nombre %>
                    </option>
                <% }) %>
            </select>
            <button type="submit">Buscar</button>
        </form>
    </div>

    <% if (typeof idPais !== 'undefined' && idPais) { %>
        <% if (sedes.length > 0) { %>
            <table>
                <tr>
                    <th>Sede</th>
                    <th>Premios ganados por el país</th>
                </tr>
                <% sedes.forEach(sede => { %>
                    <tr>
                        <td><%= sede.nombre %></td>
                        <td><%= sede.premios %></td>
                    </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p>Este país no ganó premios en ninguna sede.</p>
        <% } %>
    <% } %>
    <% if (typeof idPais !== 'undefined' && idPais && sedes.length === 0) { %>
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Sin resultados',
            text: 'Este país no ganó premios en ninguna sede.'
        });
    </script>
    <% } %>
</body>
</html>
