<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Modificar País</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <h1>Selecciona un País para Modificar</h1>
    <table>
        <tr><th>ID</th><th>Nombre</th><th>Acción</th></tr>
        <% paises.forEach(p => { %>
            <tr>
                <td><%= p.id_pais %></td>
                <td><%= p.nombre %></td>
                <td><a href="/paises/modificar/<%= p.id_pais %>">Editar</a></td>
            </tr>
        <% }) %>
    </table>
    <br><a href="/paises">Volver</a>
</body>
</html>