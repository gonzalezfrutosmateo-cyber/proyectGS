<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Eliminar País</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Selecciona un País para Eliminar</h1>
    <div class="filtro">
        <form action="/paises/eliminar" method="GET">
            <label>Buscar país:</label>
            <input type="text" name="buscar" value="<%= typeof buscar !== 'undefined' ? buscar : '' %>" placeholder="Escribe para filtrar...">
            <button type="submit">Buscar</button>
            <% if (typeof buscar !== 'undefined' && buscar) { %>
                <a href="/paises/eliminar" style="margin-left: 10px;">Mostrar todos</a>
            <% } %>
        </form>
    </div>
    <table>
        <tr><th>ID</th><th>Nombre</th><th>Acción</th></tr>
        <% paises.forEach(p => { %>
            <tr>
                <td><%= p.id_pais %></td>
                <td><%= p.nombre %></td>
                <td><a href="/paises/eliminar/<%= p.id_pais %>" class="btn-danger" onclick="confirmarEliminar(event, this.href)">Eliminar</a></td>
            </tr>
        <% }) %>
    </table>
    <br><a href="/paises">Volver</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>

    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'datos') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Datos inválidos',
            text: 'Revisa los datos ingresados e inténtalo de nuevo.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'relacion') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
        });
    </script>
    <% } %>
    <script>
        function confirmarEliminar(event, url) {
            event.preventDefault();
            Swal.fire({
                title: '¿Estás seguro?',
                text: '¡No vas a poder revertir esto!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }
    </script>
</body>
</html>