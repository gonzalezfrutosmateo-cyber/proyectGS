<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Entrenador</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Editando Entrenador</h1>
    <form action="/entrenadores/modificar/<%= entrenador.id_entrenador %>" method="POST">
        <label>Nombre:</label>
        <input type="text" name="nombre" value="<%= entrenador.nombre %>" required>

        <label>Apellido:</label>
        <input type="text" name="apellido" value="<%= entrenador.apellido %>" required>

        <label>Jugador que entrena:</label>
        <% if (actual) { %>
            <p>Actualmente entrena a <b><%= actual.nombre %> <%= actual.apellido %></b> desde el <%= actual.fecha_inicio.toLocaleDateString('es-AR') %>.</p>
        <% } else { %>
            <p>Actualmente no entrena a ningún jugador.</p>
        <% } %>
        <select name="id_jugador">
            <option value=""><%= actual ? 'Ninguno (finalizar el entrenamiento)' : 'Ninguno' %></option>
            <% jugadores.forEach(j => { %>
                <option value="<%= j.id_jugador %>" <%= actual && actual.id_jugador === j.id_jugador ? 'selected' : '' %>><%= j.nombre %> <%= j.apellido %></option>
            <% }) %>
        </select>

        <label>Fecha del cambio (solo si cambiás de jugador o finalizás el entrenamiento):</label>
        <input type="date" name="fecha_cambio">

        <button type="submit">Guardar Cambios</button>
    </form>
    <br><a href="/entrenadores/modificar">Cancelar</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>

    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'datos') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Datos inválidos',
            text: 'Revisá el nombre y apellido. Si cambiaste de jugador o finalizaste el entrenamiento, poné la fecha del cambio (no puede ser anterior al inicio del entrenamiento actual).'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'relacion') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
        });
    </script>
    <% } %>
    <script src="/js/script.js" defer></script>
</body>
</html>