<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Buscar Entrenador</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <h1>Buscar Entrenador</h1>
    <a href="/entrenadores">Volver al menú</a>

    <div class="filtro">
        <form action="/entrenadores/buscar" method="GET">
            <label>Nombre o apellido del entrenador:</label>
            <input type="text" name="buscar" value="<%= buscar %>" placeholder="Ej: Toni" required>
            <button type="submit">Buscar</button>
        </form>
    </div>

    <% if (buscar) { %>
        <h2>Resultados para "<%= buscar %>"</h2>
        <% if (entrenadores.length > 0) { %>
            <table>
                <tr><th>ID</th><th>Nombre</th><th>Apellido</th></tr>
                <% entrenadores.forEach(e => { %>
                    <tr>
                        <td><%= e.id_entrenador %></td>
                        <td><%= e.nombre %></td>
                        <td><%= e.apellido %></td>
                    </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p>No se encontró ningún entrenador con ese nombre o apellido.</p>
        <% } %>
    <% } %>
</body>
</html>
