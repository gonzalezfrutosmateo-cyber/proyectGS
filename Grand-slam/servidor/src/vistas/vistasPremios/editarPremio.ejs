<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Premio</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Editando Premio</h1>
    <form action="/premios/modificar/<%= premio.id_premio %>" method="POST">
        <label>Torneo:</label>
        <select name="id_torneo" required>
            <% torneos.forEach(t => { %>
                <option value="<%= t.id_torneo %>" <%= t.id_torneo === premio.id_torneo ? 'selected' : '' %>>
                    <%= t.nombre %> (<%= t.anio %>)
                </option>
            <% }) %>
        </select>

        <label>Fase:</label>
        <input type="text" name="fase" value="<%= premio.fase %>" required>

        <label>Monto Ganador ($):</label>
        <input type="number" name="monto_ganador" value="<%= premio.monto_ganador %>" required step="0.01">

        <label>Monto Perdedor ($):</label>
        <input type="number" name="monto_perdedor" value="<%= premio.monto_perdedor %>" required step="0.01">

        <button type="submit">Guardar Cambios</button>
    </form>
    <br><a href="/premios/modificar">Cancelar</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>

    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'datos') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Datos inválidos',
            text: 'Revisa los datos ingresados e inténtalo de nuevo.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'relacion') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
        });
    </script>
    <% } %>
    <script src="/js/script.js" defer></script>
</body>
</html>