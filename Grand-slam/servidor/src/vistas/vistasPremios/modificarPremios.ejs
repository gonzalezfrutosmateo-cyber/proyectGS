<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Modificar Premio</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <h1>Selecciona un Premio para Modificar</h1>
    <table>
        <tr><th>ID</th><th>Torneo</th><th>Fase</th><th>Acción</th></tr>
        <% premios.forEach(p => { %>
            <tr>
                <td><%= p.id_premio %></td>
                <td><%= p.torneo_nombre %></td>
                <td><%= p.fase %></td>
                <td><a href="/premios/modificar/<%= p.id_premio %>">Editar</a></td>
            </tr>
        <% }) %>
    </table>
    <br><a href="/premios">Volver</a>
</body>
</html>