<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Crear Modalidad</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Registrar Nueva Modalidad</h1>
    <form action="/modalidades/crear" method="POST">
        <label>Nombre de la Modalidad:</label>
        <input type="text" name="nombre" required placeholder="Ej: Dobles Mixtos">
        <button type="submit">Guardar Modalidad</button>
    </form>
    <br><a href="/modalidades">Volver</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>

    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'datos') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Datos inválidos',
            text: 'Revisa los datos ingresados e inténtalo de nuevo.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'relacion') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
        });
    </script>
    <% } %>
    <script src="/js/script.js" defer></script>
</body>
</html>