<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Modalidad</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Editando Modalidad</h1>
    <form action="/modalidades/modificar/<%= modalidad.id_modalidad %>" method="POST">
        <label>Nombre de la Modalidad:</label>
        <input type="text" name="nombre" value="<%= modalidad.nombre %>" required>

        <label>Tipo (cuántos jugadores hay de cada lado):</label>
        <select name="jugadores_por_lado" required>
            <option value="1" <%= modalidad.jugadores_por_lado === 1 ? 'selected' : '' %>>Individual (1 vs 1)</option>
            <option value="2" <%= modalidad.jugadores_por_lado === 2 ? 'selected' : '' %>>Dobles (2 vs 2)</option>
        </select>

        <button type="submit">Guardar Cambios</button>
    </form>
    <br><a href="/modalidades/modificar">Cancelar</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>

    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'datos') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Datos inválidos',
            text: 'Revisa los datos ingresados e inténtalo de nuevo.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'relacion') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
        });
    </script>
    <% } %>
    <script src="/js/script.js" defer></script>
</body>
</html>