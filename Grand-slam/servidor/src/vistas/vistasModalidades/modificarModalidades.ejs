<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Modificar Modalidad</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Selecciona una Modalidad para Modificar</h1>
    <table>
        <tr><th>ID</th><th>Nombre</th><th>Tipo</th><th>Acción</th></tr>
        <% modalidades.forEach(m => { %>
            <tr>
                <td><%= m.id_modalidad %></td>
                <td><%= m.nombre %></td>
                <td><%= m.jugadores_por_lado === 2 ? 'Dobles (2 vs 2)' : 'Individual (1 vs 1)' %></td>
                <td><a href="/modalidades/modificar/<%= m.id_modalidad %>">Editar</a></td>
            </tr>
        <% }) %>
    </table>
    <br><a href="/modalidades">Volver</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>
</body>
</html>