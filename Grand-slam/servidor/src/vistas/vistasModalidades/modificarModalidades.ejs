<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Modificar Modalidad</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <h1>Selecciona una Modalidad para Modificar</h1>
    <table>
        <tr><th>ID</th><th>Nombre</th><th>Acción</th></tr>
        <% modalidades.forEach(m => { %>
            <tr>
                <td><%= m.id_modalidad %></td>
                <td><%= m.nombre %></td>
                <td><a href="/modalidades/modificar/<%= m.id_modalidad %>">Editar</a></td>
            </tr>
        <% }) %>
    </table>
    <br><a href="/modalidades">Volver</a>
</body>
</html>