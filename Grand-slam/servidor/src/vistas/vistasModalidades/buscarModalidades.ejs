<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Buscar Modalidad</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/script.js" defer></script>
</head>
<body>
    <h1>Buscar Modalidad</h1>
    <a href="/modalidades">Volver al menú</a>

    <div class="filtro">
        <form action="/modalidades/buscar" method="GET">
            <label>Nombre de la modalidad:</label>
            <input type="text" name="buscar" value="<%= buscar %>" placeholder="Ej: Dobles" required>
            <button type="submit">Buscar</button>
        </form>
    </div>

    <% if (buscar) { %>
        <h2>Resultados para "<%= buscar %>"</h2>
        <% if (modalidades.length > 0) { %>
            <table>
                <tr><th>ID</th><th>Nombre</th><th>Tipo</th></tr>
                <% modalidades.forEach(m => { %>
                    <tr>
                        <td><%= m.id_modalidad %></td>
                        <td><%= m.nombre %></td>
                        <td><%= m.jugadores_por_lado === 2 ? 'Dobles (2 vs 2)' : 'Individual (1 vs 1)' %></td>
                    </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p>No se encontró ninguna modalidad con ese nombre.</p>
        <% } %>
    <% } %>
    <% if (buscar && modalidades.length === 0) { %>
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Sin resultados',
            text: 'No se encontró ninguna modalidad con ese nombre.'
        });
    </script>
    <% } %>
</body>
</html>
