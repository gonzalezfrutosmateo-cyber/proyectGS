<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Modificar Árbitro</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Selecciona un Árbitro para Modificar</h1>
    <div class="filtro">
        <form action="/arbitros/modificar" method="GET">
            <label>Buscar árbitro:</label>
            <input type="text" name="buscar" value="<%= typeof buscar !== 'undefined' ? buscar : '' %>" placeholder="Escribe para filtrar...">
            <button type="submit">Buscar</button>
            <% if (typeof buscar !== 'undefined' && buscar) { %>
                <a href="/arbitros/modificar" style="margin-left: 10px;">Mostrar todos</a>
            <% } %>
        </form>
    </div>
    <table>
        <tr><th>ID</th><th>Nombre</th><th>Apellido</th><th>Acción</th></tr>
        <% arbitros.forEach(a => { %>
            <tr>
                <td><%= a.id_arbitro %></td>
                <td><%= a.nombre %></td>
                <td><%= a.apellido %></td>
                <td><a href="/arbitros/modificar/<%= a.id_arbitro %>">Editar</a></td>
            </tr>
        <% }) %>
    </table>
    <br><a href="/arbitros">Volver</a>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>
</body>
</html>