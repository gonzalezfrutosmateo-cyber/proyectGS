<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Buscar Árbitro</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/script.js" defer></script>
</head>
<body>
    <h1>Buscar Árbitro</h1>
    <a href="/arbitros">Volver al menú</a>

    <div class="filtro">
        <form action="/arbitros/buscar" method="GET">
            <label>Nombre o apellido del árbitro:</label>
            <input type="text" name="buscar" value="<%= buscar %>" placeholder="Ej: Ramos" required>
            <button type="submit">Buscar</button>
        </form>
    </div>

    <% if (buscar) { %>
        <h2>Resultados para "<%= buscar %>"</h2>
        <% if (arbitros.length > 0) { %>
            <table>
                <tr><th>ID</th><th>Nombre</th><th>Apellido</th></tr>
                <% arbitros.forEach(a => { %>
                    <tr>
                        <td><%= a.id_arbitro %></td>
                        <td><%= a.nombre %></td>
                        <td><%= a.apellido %></td>
                    </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p>No se encontró ningún árbitro con ese nombre o apellido.</p>
        <% } %>
    <% } %>
    <% if (buscar && arbitros.length === 0) { %>
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Sin resultados',
            text: 'No se encontró ningún árbitro con ese nombre o apellido.'
        });
    </script>
    <% } %>
</body>
</html>
