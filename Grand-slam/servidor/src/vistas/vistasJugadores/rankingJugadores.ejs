<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Premios y torneos ganados</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/script.js" defer></script>
</head>
<body>
    <h1>Premios y torneos ganados por jugador</h1>
    <a href="/jugadores">Volver al menú</a>

    <div class="filtro">
        <form action="/jugadores/ranking" method="GET">
            <label>Buscar jugador:</label>
            <input type="text" name="buscar" value="<%= buscar %>" placeholder="Nombre o apellido">
            <button type="submit">Buscar</button>
        </form>
    </div>

    <% if (jugadores.length > 0) { %>
        <table>
            <tr>
                <th>Jugador</th>
                <th>Torneos ganados</th>
                <th>Premios totales</th>
            </tr>
            <% jugadores.forEach(jugador => { %>
                <tr>
                    <td><%= jugador.nombre %> <%= jugador.apellido %></td>
                    <td><%= jugador.torneos_ganados %></td>
                    <td>$<%= jugador.premios_totales %></td>
                </tr>
            <% }) %>
        </table>
    <% } else { %>
        <p>No se encontraron jugadores.</p>
    <% } %>
    <% if (buscar && jugadores.length === 0) { %>
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Sin resultados',
            text: 'No se encontraron jugadores con esa búsqueda.'
        });
    </script>
    <% } %>
</body>
</html>
