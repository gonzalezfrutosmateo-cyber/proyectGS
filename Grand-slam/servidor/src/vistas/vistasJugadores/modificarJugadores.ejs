<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Modificar Jugador</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Seleccionar Jugador a Modificar</h1>
    <a href="/jugadores" class="menu-btn" style="width: 200px; display: inline-block; margin-bottom: 10px;">⬅ Volver al Menú</a>

    <div class="filtro">
        <form action="/jugadores/modificar" method="GET">
            <label>Buscar jugador:</label>
            <input type="text" name="buscar" value="<%= typeof buscar !== 'undefined' ? buscar : '' %>" placeholder="Escribe para filtrar...">
            <button type="submit">Buscar</button>
            <% if (typeof buscar !== 'undefined' && buscar) { %>
                <a href="/jugadores/modificar" style="margin-left: 10px;">Mostrar todos</a>
            <% } %>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            // Aquí se listarán los jugadores para seleccionar cuál modificar
            <% if (jugadores && jugadores.length > 0) { %>
                <% jugadores.forEach(jugador => { %>
                    <tr>
                        <td><%= jugador.id_jugador %></td>
                        <td><%= jugador.nombre %></td>
                        <td><%= jugador.apellido %></td>
                        <td>
                            <a href="/jugadores/modificar/<%= jugador.id_jugador %>">Editar</a>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>
</body>
</html>