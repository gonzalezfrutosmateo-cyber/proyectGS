<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Historial por jugador</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Historial de torneos de un jugador</h1>
    <a href="/jugadores">Volver al menú</a>

    <div class="filtro">
        <form action="/jugadores/historial" method="GET">
            <label>Jugador:</label>
            <select name="id_jugador" required>
                <option value="">Seleccione...</option>
                <% jugadores.forEach(jugador => { %>
                    <option value="<%= jugador.id_jugador %>" <%= idJugador == jugador.id_jugador ? 'selected' : '' %>>
                        <%= jugador.nombre %> <%= jugador.apellido %>
                    </option>
                <% }) %>
            </select>
            <label>Año (opcional):</label>
            <input type="number" name="anio" value="<%= anio %>" min="1877" max="<%= new Date().getFullYear() %>">
            <button type="submit">Buscar historial</button>
        </form>
    </div>

    <% if (idJugador) { %>
        <% if (historial.length > 0) { %>
            <table>
                <tr>
                    <th>Torneo</th>
                    <th>Año</th>
                    <th>Modalidad</th>
                    <th>Partidos jugados</th>
                    <th>Partidos ganados</th>
                    <th>Premios</th>
                </tr>
                <% historial.forEach(registro => { %>
                    <tr>
                        <td><%= registro.torneo %></td>
                        <td><%= registro.anio %></td>
                        <td><%= registro.modalidad %></td>
                        <td><%= registro.partidos_jugados %></td>
                        <td><%= registro.partidos_ganados %></td>
                        <td>$<%= registro.premios %></td>
                    </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p>No hay partidos registrados para ese jugador y año.</p>
        <% } %>
    <% } %>
    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'anio') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Año inválido',
            text: 'Ingresa un año entre 1877 y <%= new Date().getFullYear() %>.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'jugador') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Jugador inválido',
            text: 'Selecciona un jugador de la lista.'
        });
    </script>
    <% } else if (idJugador && historial.length === 0) { %>
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Sin resultados',
            text: 'No hay partidos registrados para ese jugador y año.'
        });
    </script>
    <% } %>
    <script src="/js/script.js" defer></script>
</body>
</html>
