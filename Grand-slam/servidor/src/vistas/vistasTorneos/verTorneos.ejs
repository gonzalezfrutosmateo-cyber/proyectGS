<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Lista de Torneos</title>
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <h1>Torneos Registrados</h1>
    <a href="/torneos">Volver al menú</a>
    
    <table>
        <tr><th>ID</th><th>Nombre</th><th>Año</th><th>Sede</th><th>País</th></tr>
        <% torneos.forEach(t => { %>
            <tr>
                <td><%= t.id_torneo %></td>
                <td><%= t.nombre %></td>
                <td><%= t.anio %></td>
                <td><%= t.sede_nombre %></td>
                <td><%= t.pais_nombre %></td>
            </tr>
        <% }) %>
    </table>

    <% if (typeof status !== 'undefined' && status === 'success') { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Operación realizada',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
    <% } %>

    <% if (typeof status !== 'undefined' && status === 'error' && tipo === 'datos') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Datos inválidos',
            text: 'Revisa los datos ingresados e inténtalo de nuevo.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error' && tipo === 'relacion') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se puede eliminar este registro porque está relacionado con otros datos.'
        });
    </script>
    <% } else if (typeof status !== 'undefined' && status === 'error') { %>
    <script>
        Swal.fire({
            icon: 'error',
            title: 'No se pudo completar',
            text: 'No se pudo completar la operación. Comprueba los datos e inténtalo de nuevo.'
        });
    </script>
    <% } %>
</body>
</html>