<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta Cliente</title>
</head>

<body>
    <h1>ALTA DE CLIENTES</h1>
    <form action="/nuevocli" method="POST">
        <input name="idclientes" type="text" placeholder="CUIT" maxlength="8" size="15">
        <input name="nombre" type="text" placeholder="Nombre" maxlength="8" size="15">
        <input name="direccion" type="text" placeholder="Dirección" maxlength="8" size="15">
        <input name="telefono" type="text" placeholder="Teléfono" maxlength="8" size="15">
        <input name="ciudad" type="text" placeholder="Ciudad" maxlength="8" size="15">
        <button type="submit">Registrar</button>
    </form>
</body>

</html>